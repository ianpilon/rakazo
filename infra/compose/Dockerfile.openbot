# Open Bot app image. Same result as infra/compose/Dockerfile, but installs
# dependencies from the lockfile before copying source, so a source change
# no longer re-downloads every package (a full reinstall needs several GB of
# scratch space, which exhausted the Docker Desktop disk twice).
FROM node:22-bookworm@sha256:0557ac14e0d45d02ed563067b82856ca5e7aa3437fa28d98d4350ea9c3d9494a
RUN corepack enable
WORKDIR /app
# Manifests only: lockfile, workspace file, every package.json, patches.
COPY --chmod=755 package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY --chmod=755 patches ./patches
COPY --chmod=755 manifests/ ./
RUN pnpm install --frozen-lockfile
# Now the source. node_modules from the layer above survive because COPY
# merges into the existing tree.
COPY --chmod=755 . .
RUN pnpm --filter @rakazo/db generate
RUN RAKAZO_ALLOW_DEV_SECRETS=1 pnpm --filter @rakazo/web build
RUN install -d -m 750 -o node -g node /data /app/apps/web/node_modules/.vite-temp
ARG GIT_SHA
ENV NODE_ENV=production
ENV GIT_SHA=$GIT_SHA
EXPOSE 3100 5173 7091
USER node
CMD ["pnpm", "--filter", "@rakazo/api", "start"]
